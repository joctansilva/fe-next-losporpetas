# =============================================================================
# LOSPORPETAS — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha.
# .env.local NUNCA vai para o git (ver .gitignore).
#
# Regra de ouro: só recebe o prefixo NEXT_PUBLIC_ o que pode ser lido por
# qualquer visitante — o Next embute essas variáveis no bundle do navegador.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
#
# Desenvolvimento local: rode `pnpm db:start` e depois `pnpm db:status`.
# A CLI imprime a API URL, a anon key e a service_role key locais.
#
# Produção: Supabase Dashboard → Project Settings → API.
# -----------------------------------------------------------------------------

# Pública. Aparece em toda requisição — não é segredo.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"

# Pública por design. Quem protege os dados é a RLS, não esta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ SEGREDO. Ignora RLS por completo — vazou, o banco inteiro foi junto.
# Nunca prefixe com NEXT_PUBLIC_. Nunca comite. Nunca use no cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------

# URL canônica do site. Usada em metadata, Open Graph, sitemap e canonical.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# A PARTIR DA FASE 3 — formulários, anti-spam e e-mail
# Descomente conforme cada fase entra.
# -----------------------------------------------------------------------------

# Resend — e-mail transacional (lead, sugestão, newsletter)
# RESEND_API_KEY=""
# CONTACT_INBOX="contato@losporpetas.com.br"

# Cloudflare Turnstile — anti-spam dos formulários públicos
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Sal usado para gerar hash de IP (anti-abuso sem guardar IP puro — LGPD).
# Gere um valor aleatório longo e único por ambiente.
# IP_HASH_SALT=""

# -----------------------------------------------------------------------------
# A PARTIR DA FASE 4/5 — automações
# -----------------------------------------------------------------------------

# Segredo do webhook de revalidação de cache (banco → /api/revalidate)
# REVALIDATE_SECRET=""

# Segredo do Vercel Cron (encerramento automático de campanhas)
# CRON_SECRET=""
